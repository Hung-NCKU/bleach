  <ns0:library_effects>
    <ns0:effect id="f_waraji_mtl-fx" name="f_waraji_mtl">
      <ns0:profile_COMMON>
        <ns0:newparam sid="ran_waraji_png-surface">
          <ns0:surface type="2D">
            <ns0:init_from>ran_waraji.png</ns0:init_from>
            <ns0:format>A8R8G8B8</ns0:format>
          </ns0:surface>
        </ns0:newparam>
        <ns0:newparam sid="ran_waraji_png-sampler">
          <ns0:sampler2D>
            <ns0:source>ran_waraji_png-surface</ns0:source>
            <ns0:wrap_s>WRAP</ns0:wrap_s>
            <ns0:wrap_t>WRAP</ns0:wrap_t>
            <ns0:minfilter>NONE</ns0:minfilter>
            <ns0:magfilter>NONE</ns0:magfilter>
            <ns0:mipfilter>NONE</ns0:mipfilter>
          </ns0:sampler2D>
        </ns0:newparam>
        <ns0:technique sid="common">
          <ns0:phong>
            <ns0:ambient>
              <ns0:color>0.2 0.2 0.2 1</ns0:color>
            </ns0:ambient>
            <ns0:diffuse>
              <ns0:texture texture="ran_waraji_png-sampler" texcoord="CHANNEL1">
                <ns0:extra>
                  <ns0:technique profile="MAYA">
                    <ns0:mirrorU>0</ns0:mirrorU>
                    <ns0:mirrorV>0</ns0:mirrorV>
                    <ns0:wrapU>1</ns0:wrapU>
                    <ns0:wrapV>1</ns0:wrapV>
                    <ns0:repeatU>1</ns0:repeatU>
                    <ns0:repeatV>1</ns0:repeatV>
                    <ns0:offsetU>0</ns0:offsetU>
                    <ns0:offsetV>0</ns0:offsetV>
                    <ns0:rotateUV>0</ns0:rotateUV>
                  </ns0:technique>
                  <ns0:technique profile="MAX3D">
                    <ns0:amount>1</ns0:amount>
                  </ns0:technique>
                </ns0:extra>
              </ns0:texture>
            </ns0:diffuse>
            <ns0:specular>
              <ns0:color>0.2 0.2 0.2 1</ns0:color>
            </ns0:specular>
            <ns0:shininess>
              <ns0:float>43.2193</ns0:float>
            </ns0:shininess>
            <ns0:reflective>
              <ns0:color>0 0 0 1</ns0:color>
            </ns0:reflective>
            <ns0:reflectivity>
              <ns0:float>1</ns0:float>
            </ns0:reflectivity>
            <ns0:transparent opaque="A_ONE">
              <ns0:color>1 1 1 1</ns0:color>
            </ns0:transparent>
            <ns0:transparency>
              <ns0:float>1</ns0:float>
            </ns0:transparency>
          </ns0:phong>
          <ns0:extra>
            <ns0:technique profile="FCOLLADA">
              <ns0:emission_level>
                <ns0:float>0</ns0:float>
              </ns0:emission_level>
            </ns0:technique>
          </ns0:extra>
        </ns0:technique>
      </ns0:profile_COMMON>
      <ns0:extra>
        <ns0:technique profile="MAX3D">
          <ns0:faceted>0</ns0:faceted>
          <ns0:double_sided>0</ns0:double_sided>
          <ns0:wireframe>0</ns0:wireframe>
